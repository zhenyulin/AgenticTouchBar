# optional fallback free weather API provider
# > console.qweather.com; leave both unset to skip QWeather entirely and use
# > the foreign sources only
BTT_WEATHER_QW_HOST=
BTT_WEATHER_QW_KEY=

# optional ClinePass API key for the ClinePass quota widget
# > the key used to access ClinePass models; CLINEPASS_API_KEY also works
# > leave unset to fall back to Cline's saved sign-in under ~/.cline/data
CLINE_API_KEY=
