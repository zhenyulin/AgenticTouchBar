# cspell:ignore LRCLIB LrcAPI

classes: {
  entry: {
    style.fill: "#E8F1FB"
    style.stroke: "#32689A"
    style.border-radius: 6
  }
  process: {
    style.fill: "#EEF6EE"
    style.stroke: "#4D7C4D"
    style.border-radius: 6
  }
  state: {
    style.fill: "#FFF6E5"
    style.stroke: "#B47A1F"
    style.border-radius: 6
  }
  external: {
    style.fill: "#F3EDF8"
    style.stroke: "#76539A"
    style.border-radius: 6
  }
  diagnostic: {
    style.fill: "#F7EEEE"
    style.stroke: "#A34E4E"
    style.border-radius: 6
  }
}
