        {
          "BTTLastUpdatedAt" : 1786145759.362051,
          "BTTTriggerType" : 639,
          "BTTTriggerTypeDescriptionReadOnly" : "Apple Script \/ JavaScript Widget",
          "BTTTriggerTypeDescription" : "Star",
          "BTTTriggerClass" : "BTTTriggerTypeTouchBar",
          "BTTUUID" : "A05C5D37-7EAA-4F7B-AC00-23183CC8C6A1",
          "BTTOrder" : 2,
          "BTTMergeIntoTouchBarGroups" : 0,
          "BTTActionsToExecute" : [
            {
              "BTTLastUpdatedAt" : 1786145689.1727929,
              "BTTTriggerParentUUID" : "A05C5D37-7EAA-4F7B-AC00-23183CC8C6A1",
              "BTTIsPureAction" : true,
              "BTTTriggerClass" : "BTTTriggerTypeTouchBar",
              "BTTUUID" : "2C41450D-D3B5-4387-8A1B-D79EA83EC051",
              "BTTPredefinedActionType" : 195,
              "BTTPredefinedActionName" : "Run Apple Script (async in background)",
              "BTTAdditionalActionData" : {
                "BTTScriptType" : 0,
                "BTTAppleScriptUsePath" : false,
                "BTTScriptLocation" : 0,
                "BTTAppleScriptRunInBackground" : true,
                "SelectedAction" : 195,
                "BTTAppleScriptString" : "set widgetUUID to \"A05C5D37-7EAA-4F7B-AC00-23183CC8C6A1\"\n\nif application \"Music\" is running then\n    tell application \"Music\"\n        if player state is not stopped then\n            set oldFavorite to favorited of current track\n            set newFavorite to not oldFavorite\n\n            if newFavorite then\n                set newSymbol to \"★\"\n            else\n                set newSymbol to \"☆\"\n            end if\n\n            -- Update Touch Bar immediately, before Apple Music finishes.\n            tell application \"BetterTouchTool\"\n                update_touch_bar_widget widgetUUID text newSymbol\n            end tell\n\n            -- Apple Music can take a moment to persist this.\n            set favorited of current track to newFavorite\n\n            -- Never let BTT display \"missing value\".\n            return newSymbol\n        end if\n    end tell\nend if\n\nreturn \"\""
              },
              "BTTInlineAppleScript" : "set widgetUUID to \"A05C5D37-7EAA-4F7B-AC00-23183CC8C6A1\"\n\nif application \"Music\" is running then\n    tell application \"Music\"\n        if player state is not stopped then\n            set oldFavorite to favorited of current track\n            set newFavorite to not oldFavorite\n\n            if newFavorite then\n                set newSymbol to \"★\"\n            else\n                set newSymbol to \"☆\"\n            end if\n\n            -- Update Touch Bar immediately, before Apple Music finishes.\n            tell application \"BetterTouchTool\"\n                update_touch_bar_widget widgetUUID text newSymbol\n            end tell\n\n            -- Apple Music can take a moment to persist this.\n            set favorited of current track to newFavorite\n\n            -- Never let BTT display \"missing value\".\n            return newSymbol\n        end if\n    end tell\nend if\n\nreturn \"\"",
              "BTTOrder" : 10,
              "BTTMergeIntoTouchBarGroups" : 0
            }
          ],
