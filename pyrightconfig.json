{
  "typeCheckingMode": "standard",
  "exclude": [
    // hidden files and directories
    "**/__*cache__",
    "**/.*",
    "**/node_modules",
    // tooling
    "**/*_log*",
    "**/*.egg-info",
    "**/*.log*",
    "**/*nbqa*.py",
    "**/report",
    "**/temp",
    "**/tmp",
    // runtime output
    "**/output",
    "**/storage",
    // build
    "build",
    "dist",
    // selected folders
    "notebook",
    "tests",
    "**/__pycache__",
    ".venv"
  ],

  // Deliberately an error, not "none". Pyright resolves third-party types from
  // the environment's site-packages; when it cannot find that environment it
  // reports nothing at all rather than failing, so a broken or unsynced venv
  // would look like a clean type check. Untyped-library noise is suppressed by
  // reportMissingTypeStubs below, which is a separate concern.
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "none",

  "reportUnnecessaryCast": "warning",
  "reportUnnecessaryTypeIgnoreComment": "warning",
  "reportUnreachable": "warning"
}
